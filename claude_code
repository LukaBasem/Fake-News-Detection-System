# ==================================================
# 🗄️ SQLite — DB init (Week 5)
# ==================================================
def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS history (
            id          TEXT PRIMARY KEY,
            input_text  TEXT,
            input_url   TEXT,
            summary     TEXT,
            verdict     TEXT,
            result_json TEXT,
            created_at  TEXT
        )
    """)
    conn.commit()
    conn.close()


def save_to_db(record: dict):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute(
        "INSERT INTO history VALUES (?,?,?,?,?,?,?)",
        (
            record["id"],
            record.get("input_text", ""),
            record.get("input_url", ""),
            record.get("summary", ""),
            record.get("verdict", ""),
            json.dumps(record.get("verification", [])),
            record.get("created_at", ""),
        )
    )
    conn.commit()
    conn.close()


def fetch_history(limit: int = 20):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute(
        "SELECT id, input_text, input_url, summary, verdict, created_at "
        "FROM history ORDER BY created_at DESC LIMIT ?",
        (limit,)
    )
    rows = c.fetchall()
    conn.close()
    return [
        {
            "id": r[0], "input_text": r[1], "input_url": r[2],
            "summary": r[3], "verdict": r[4], "created_at": r[5]
        }
        for r in rows
    ]


def fetch_one(check_id: str):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT * FROM history WHERE id=?", (check_id,))
    row = c.fetchone()
    conn.close()
    if not row:
        return None
    return {
        "id": row[0], "input_text": row[1], "input_url": row[2],
        "summary": row[3], "verdict": row[4],
        "verification": json.loads(row[5]), "created_at": row[6]
    }


