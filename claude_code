# 📋 /analyze — main endpoint (Week 2 + 3)
# ---------------------------------------------------
@app.post("/analyze", tags=["Analysis"])
@limiter.limit("10/minute")
def analyze(request: Request, data: AnalyzeRequest):
    text = data.text
    input_url = data.url

    if input_url:
        text = extract_text_from_url(input_url)
        if not text:
            raise HTTPException(status_code=422, detail="Could not extract text from URL")

    if not text or len(text.strip()) < 50:
        raise HTTPException(status_code=422, detail="Text is too short or missing")

    # Step 1 — Extract claims
    extraction = extract_claims(text)
    if not extraction:
        raise HTTPException(status_code=500, detail="LLM failed during claim extraction")

    claims  = extraction.get("claims", [])
    summary = extraction.get("summary", "")

    # Step 2 — Verify each claim
    verification = []
    for claim in claims:
        articles = search_news(claim)

        if not articles:
            verification.append({
                "claim":      claim,
                "verdict":    "UNKNOWN",
                "reason":     "No news sources found for this claim",
                "confidence": 0.3,
                "sources":    [],
            })
            continue

        verdict_data = check_claim(claim, articles)

        # Format sources for frontend
        sources = [
            {
                "title":       a.get("title", ""),
                "url":         a.get("url", ""),
                "source_name": a.get("source", {}).get("name", ""),
                "published_at": a.get("publishedAt", ""),
            }
            for a in articles
        ]

        verification.append({
            "claim":      claim,
            "verdict":    verdict_data["verdict"],
            "reason":     verdict_data["reason"],
            "confidence": verdict_data["confidence"],
            "sources":    sources,
        })

    # Step 3 — Overall verdict
    overall = get_overall_verdict(verification)

    # Step 4 — Save to SQLite (Week 5)
    record_id = str(uuid.uuid4())
    record = {
        "id":           record_id,
        "input_text":   text[:500],
        "input_url":    input_url or "",
        "summary":      summary,
        "verdict":      overall["label"],
        "verification": verification,
        "created_at":   datetime.utcnow().isoformat(),
    }
    save_to_db(record)

    return {
        "id":             record_id,
        "summary":        summary,
        "overall_verdict": overall,
        "verification":   verification,
        "created_at":     record["created_at"],
    }


