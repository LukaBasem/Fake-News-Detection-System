# 🌐 Web scraper (Week 2)
# ==================================================
def extract_text_from_url(url: str) -> str:
    try:
        headers = {"User-Agent": "Mozilla/5.0"}
        res = requests.get(url, timeout=10, headers=headers)
        soup = BeautifulSoup(res.text, "html.parser")
        # Remove nav/footer/script noise
        for tag in soup(["script", "style", "nav", "footer", "header"]):
            tag.decompose()
        paragraphs = soup.find_all("p")
        text = " ".join(p.get_text(strip=True) for p in paragraphs)
        return text[:6000]  # Cap to avoid token overflow
    except Exception as e:
        return ""


# ==================================================
# 🔍 NewsAPI search (Week 3)
# ==================================================
def search_news(query: str) -> list:
    if not NEWS_API_KEY or NEWS_API_KEY == "YOUR_NEWS_API_KEY":
        return []
    url = (
        f"https://newsapi.org/v2/everything"
        f"?q={requests.utils.quote(query)}"
        f"&language=en&sortBy=relevancy&pageSize=3"
        f"&apiKey={NEWS_API_KEY}"
    )
    try:
        res = requests.get(url, timeout=10).json()
        return res.get("articles", [])[:3]
    except:
        return []


# ==================================================
# 🧠 LLM call — Ollama or Groq (Week 2 + fallback)
# ==================================================
def call_llm(prompt: str, system: str = "") -> Optional[str]:
    if USE_GROQ:
        return _call_groq(prompt, system)
    return _call_ollama(prompt)


def _call_ollama(prompt: str) -> Optional[str]:
    try:
        response = requests.post(
            f"{OLLAMA_URL}/api/generate",
            json={"model": "llama3", "prompt": prompt, "stream": False},
            timeout=90,
        )
        return response.json().get("response", "")
    except Exception as e:
        return None


def _call_groq(prompt: str, system: str = "") -> Optional[str]:
    """Groq API — llama3-8b-8192, much faster than local Ollama"""
    try:
        messages = []
        if system:
            messages.append({"role": "system", "content": system})
        messages.append({"role": "user", "content": prompt})

        response = requests.post(
            "https://api.groq.com/openai/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {GROQ_API_KEY}",
                "Content-Type": "application/json",
            },
            json={
                "model": "llama3-8b-8192",
                "messages": messages,
                "temperature": 0.2,
                "max_tokens": 1000,
            },
            timeout=30,
        )
        data = response.json()
        return data["choices"][0]["message"]["content"]
    except Exception as e:
        return None


# ==================================================
# 🧩 JSON extraction helper
# ==================================================
def parse_json_from_llm(raw: str) -> dict:
    if not raw:
        return {}
    # Strip markdown code fences if present
    raw = re.sub(r"```(?:json)?", "", raw).strip()
    match = re.search(r"\{.*\}", raw, re.DOTALL)
    try:
        return json.loads(match.group()) if match else {}
    except:
        return {}


# ==================================================
# 📝 Claim extraction (Week 2)
# ==================================================
def extract_claims(text: str) -> dict:
    prompt = f"""You are a fact-checking assistant.

Analyze the following text and extract factual claims that can be verified.

Rules:
- Extract 3 to 5 specific, verifiable factual claims
- Do NOT invent or add facts not present in the text
- Keep each claim short (one sentence)
- Write a brief neutral summary of the text

Return ONLY valid JSON (no markdown, no extra text):
{{
  "summary": "brief neutral summary here",
  "claims": ["claim 1", "claim 2", "claim 3"]
}}

Text:
{text[:4000]}
"""
    raw = call_llm(prompt, system="You are a fact-checking assistant. Always respond with valid JSON only.")
    result = parse_json_from_llm(raw)
    return result


# ==================================================
# ✅ Claim verification (Week 3)
# ==================================================
def check_claim(claim: str, articles: list) -> dict:
    content = " ".join([
        f"[{a.get('source', {}).get('name', 'Source')}]: "
        f"{a.get('title', '')} — {a.get('description', '')}"
        for a in articles
    ])[:3000]

    prompt = f"""You are a strict fact-checking AI.

Claim to verify:
"{claim}"

Available news sources:
{content}

Based ONLY on the sources above, determine if the claim is TRUE, FALSE, or UNKNOWN.
- TRUE: sources clearly support the claim
- FALSE: sources clearly contradict the claim
- UNKNOWN: sources are insufficient or unrelated

Return ONLY valid JSON:
{{
  "verdict": "TRUE",
  "reason": "brief explanation citing the sources",
  "confidence": 0.85
}}

confidence must be a float between 0.0 and 1.0.
"""
    raw = call_llm(prompt, system="You are a fact-checking assistant. Always respond with valid JSON only.")
    result = parse_json_from_llm(raw)

    if not result:
        return {"verdict": "UNKNOWN", "reason": "LLM unavailable or parse error", "confidence": 0.3}

    # Normalize confidence
    confidence = float(result.get("confidence", 0.5))
    confidence = max(0.0, min(1.0, confidence))

    return {
        "verdict": result.get("verdict", "UNKNOWN"),
        "reason":  result.get("reason", ""),
        "confidence": confidence,
    }


# ==================================================
# 📊 Overall verdict (Week 3)
# ==================================================
def get_overall_verdict(verification: list) -> dict:
    true_count    = sum(1 for v in verification if v["verdict"] == "TRUE")
    false_count   = sum(1 for v in verification if v["verdict"] == "FALSE")
    unknown_count = sum(1 for v in verification if v["verdict"] == "UNKNOWN")
    total         = len(verification)

    avg_confidence = (
        sum(v["confidence"] for v in verification) / total if total else 0.0
    )

    if false_count > true_count and false_count > unknown_count:
        label = "LIKELY FAKE ❌"
        score = 0.2
    elif true_count > false_count and true_count > unknown_count:
        label = "LIKELY TRUE ✅"
        score = 0.8
    else:
        label = "UNCERTAIN ⚠️"
        score = 0.5

    return {
        "label": label,
        "true_count":    true_count,
        "false_count":   false_count,
        "unknown_count": unknown_count,
        "avg_confidence": round(avg_confidence, 2),
        "overall_score":  score,          # 0–1 for Recharts gauge (Week 6)
    }


