# 🤖 AI-written text detector (Week 6 bonus)
# ==================================================
def detect_ai_text(text: str) -> dict:
    prompt = f"""You are an expert in detecting AI-generated text.

Analyze the following text and determine if it was written by a human or generated by AI.

Look for these signals:
- Overly uniform sentence structure
- Lack of personal voice or emotion
- Generic phrasing and filler phrases
- Unusual fluency with no typos or colloquialisms
- Repetitive transitional phrases

Return ONLY valid JSON:
{{
  "is_ai_generated": true,
  "confidence": 0.85,
  "signals": ["signal 1", "signal 2"],
  "explanation": "brief explanation"
}}

Text:
{text[:3000]}
"""
    raw = call_llm(prompt, system="You are an AI text detection expert. Always respond with valid JSON only.")
    result = parse_json_from_llm(raw)

    if not result:
        return {
            "is_ai_generated": None,
            "confidence": 0.0,
            "signals": [],
            "explanation": "Detection unavailable"
        }
    return result


